{
  "name": "platypus-officer-hub",
  "private": true,
  "version": "1.0.0-wp0",
  "type": "module",
  "description": "Platypus: a team AI chief of staff for student organizations (ASU Barrett honors thesis prototype).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck:netlify": "tsc --noEmit -p tsconfig.netlify.json",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint:css": "stylelint src/styles.css",
    "lint:js": "eslint src",
    "lint": "npm run lint:css && npm run lint:js",
    "words": "node scripts/word-count.mjs",
    "check": "npm run lint && npm run build && npm test && npm run e2e && npm run words",
    "eval:rules": "node scripts/eval-rules.mjs",
    "eval:mock": "vitest run src/test/rules-eval.test.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.6",
    "@xyflow/react": "^12.12.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@netlify/functions": "2.8.2",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.14.0",
    "eslint-plugin-react": "7.37.2",
    "jsdom": "25.0.1",
    "stylelint": "16.10.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
