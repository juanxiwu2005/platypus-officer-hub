{
  "name": "platypus-officer-hub",
  "private": true,
  "version": "1.0.0-wp0",
  "type": "module",
  "description": "Platypus: a team AI chief of staff for student organizations (ASU Barrett honors thesis prototype).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run build && npm test && npm run e2e",
    "eval:rules": "node scripts/eval-rules.mjs",
    "eval:mock": "vitest run src/test/rules-eval.test.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@netlify/functions": "2.8.2",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
