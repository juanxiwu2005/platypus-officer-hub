{
  "name": "platypus-officer-hub",
  "private": true,
  "version": "1.0.0-wp0",
  "type": "module",
  "description": "Platypus: a team AI chief of staff for student organizations (ASU Barrett honors thesis prototype).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck:netlify": "tsc --noEmit -p tsconfig.netlify.json",
    "preview": "vite preview --port ${PW_PORT:-4173} --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint:css": "stylelint \"src/styles.css\" \"src/styles/*.css\"",
    "lint:js": "eslint src && node scripts/lint-guardrails.mjs",
    "lint": "npm run lint:english && npm run lint:css && npm run lint:js",
    "words": "node scripts/word-count.mjs",
    "check": "npm run lint && npm run build && npm test && npm run e2e && npm run words",
    "eval:rules": "node scripts/eval-rules.mjs",
    "eval:mock": "vitest run src/test/rules-eval.test.ts",
    "lint:english": "node scripts/check-english.mjs",
    "test:english": "node --test scripts/check-english.test.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.6",
    "@xyflow/react": "^12.12.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@netlify/functions": "6.0.3",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-x": "5.28.8",
    "jsdom": "29.1.1",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
