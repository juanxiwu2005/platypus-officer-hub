# Keep configuration notes in English; see CONTRIBUTING.md.
# Copy these names into Netlify → Project configuration → Environment variables.
# Never commit real keys. Scope must include "Functions". Redeploy after changing them.

AI_PRESET=asu_air           # asu_air (the project default; every AI call goes to ASU AIR)
AI_API_KEY=                 # secret — paste in Netlify only, mark "Contains secret values"
# AI_MODEL=                # optional for asu_air: routing v3 picks the model per task
# AI_BASE_URL=              # optional override of the API address
# AI_JSON_MODE=json_object  # set to "none" if a provider rejects JSON mode
# AI_TIMEOUT_MS=25000

# AIR defaults to Muse Glimmer; GLM is an explicit deeper-review choice in src/organization/modelPolicy.ts.
# AI_MODEL_ROUTING=off      # explicit rollback to AI_MODEL; default routing is enabled for AIR
# AI_REASONING_EFFORT=none  # applies when task routing is off
