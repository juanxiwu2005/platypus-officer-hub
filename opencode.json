  "agent": {
    "backend-coder": {
      "steps": 300,
      "permission": {
        "*": "deny",
        "external_directory": "deny",
        "execute": "deny",
        "code": "deny",
        "run": "deny",
        "read": {
          "*": "deny",
          "docs/quest-build/AGENT_BRIEF.md": "allow",
          "docs/quest-build/cards/P5-08A-prologue.md": "allow",
          "src/quest/sample/model.ts": "allow",
          "src/engine/questSchedule.ts": "allow",
          "src/lib/motion.ts": "allow",
          "src/styles/quest-foundation.css": "allow",
          "src/styles/dx-00-tokens.css": "allow",
          "src/quest/sample/Prologue.tsx": "allow",
          "src/quest/sample/story.ts": "allow",
          "src/styles/quest-prologue.css": "allow"
        },
        "edit": {
          "*": "deny",
          "src/quest/sample/Prologue.tsx": "allow",
          "src/quest/sample/story.ts": "allow",
          "src/styles/quest-prologue.css": "allow"
        },
        "bash": {
          "*": "deny",
          "npx tsc --noEmit -p tsconfig.json": "allow"
