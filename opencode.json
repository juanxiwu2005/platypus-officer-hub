{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "external_directory": "deny",
    "read": {
      "*": "deny"
    },
    "edit": {
      "*": "deny"
    },
    "bash": {
      "*": "deny"
    },
    "execute": "deny",
    "code": "deny",
    "run": "deny"
  },
  "agent": {
    "backend-coder": {
      "steps": 300,
      "permission": {
        "*": "deny",
        "external_directory": "deny",
        "execute": "deny",
        "code": "deny",
        "run": "deny",
        "read": {
          "*": "deny",
          "docs/quest-build/AGENT_BRIEF.md": "allow",
          "docs/quest-build/cards/P5-04-countdown-view.md": "allow",
          "src/quest/Quest.tsx": "allow",
          "src/quest/foundation.ts": "allow",
          "src/engine/questSchedule.ts": "allow",
          "src/lib/dragSort.ts": "allow",
          "src/lib/dates.ts": "allow",
          "src/styles/quest-foundation.css": "allow",
          "src/quest/sample/Timeline.tsx": "allow",
          "src/quest/sample/Timeline.test.tsx": "allow"
        },
        "edit": {
          "*": "deny",
          "src/quest/sample/Timeline.tsx": "allow",
          "src/quest/sample/Timeline.test.tsx": "allow"
        },
        "bash": {
          "*": "deny",
          "npx vitest run src/quest/sample/Timeline.test.tsx": "allow",
          "npx tsc --noEmit -p tsconfig.json": "allow"
        }
      }
    },
    "code-critic": {
      "steps": 300,
      "permission": {
        "*": "deny",
        "external_directory": "deny",
        "execute": "deny",
        "code": "deny",
        "run": "deny",
        "read": {
          "*": "deny",
          "docs/quest-build/AGENT_BRIEF.md": "allow",
          "docs/quest-build/cards/P5-04-countdown-view.md": "allow",
          "src/quest/Quest.tsx": "allow",
          "src/quest/foundation.ts": "allow",
          "src/engine/questSchedule.ts": "allow",
          "src/lib/dragSort.ts": "allow",
          "src/lib/dates.ts": "allow",
          "src/styles/quest-foundation.css": "allow",
          "src/quest/sample/Timeline.tsx": "allow",
          "src/quest/sample/Timeline.test.tsx": "allow"
        },
        "edit": {
          "*": "deny"
        },
        "bash": {
          "*": "deny"
        }
      }
    }
  }
}
