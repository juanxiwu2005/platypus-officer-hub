{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "external_directory": "deny",
    "read": {
      "*": "deny"
    },
    "edit": {
      "*": "deny"
    },
    "bash": {
      "*": "deny"
    },
    "execute": "deny",
    "code": "deny",
    "run": "deny"
