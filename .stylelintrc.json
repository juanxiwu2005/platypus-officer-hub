{
  "rules": {
    "no-duplicate-selectors": true,
    "color-no-hex": true,
    "declaration-property-value-allowed-list": {
      "font-size": [
        "/^var\\(--fs-[a-z0-9]+\\)$/",
        "inherit"
      ],
      "font": [
        "inherit",
        "/^15px\\/1\\.55 var\\(--sans\\)$/",
        "/^600 13\\.5px\\/1\\.3 var\\(--sans\\)$/"
      ],
      "/^border(-(top|bottom)-(left|right))?-radius$/": [
        "0",
        "inherit",
        "var(--radius)",
        "/^var\\(--r-[a-z]+\\)$/",
        "/^(var\\(--r-[a-z]+\\)|0)( (var\\(--r-[a-z]+\\)|0)){1,3}$/"
      ],
      "z-index": [
        "/^var\\(--z-[a-z-]+\\)$/"
      ]
    }
  },
  "overrides": [
    {
      "files": [
        "src/styles/dx-0[1-9]-*.css",
        "src/styles/dx-[1-9][0-9]-*.css",
        "src/styles/ob-[0-9][0-9]-*.css",
        "src/styles/fb-[0-9][0-9]-*.css"
      ],
      "rules": {
        "declaration-no-important": true,
        "declaration-property-value-disallowed-list": {
          "transition": [
            "/(^|[\\s,])all(?=[\\s,]|$)/",
            "/(^|[\\s,(])(?!0m?s(?=[\\s,)]|$))-?(\\d*\\.)?\\d+m?s(?=[\\s,)]|$)/",
            "/(^|[\\s,])(left|top|right|bottom|width|height|margin|padding)(?=[\\s,]|$)/"
          ],
          "transition-property": [
            "/(^|[\\s,])all(?=[\\s,]|$)/",
            "/(^|[\\s,])(left|top|right|bottom|width|height|margin|padding)(?=[\\s,]|$)/"
          ],
          "transition-duration": [
            "/(^|[\\s,(])(?!0m?s(?=[\\s,)]|$))-?(\\d*\\.)?\\d+m?s(?=[\\s,)]|$)/"
          ],
          "transition-delay": [
            "/(^|[\\s,(])(?!0m?s(?=[\\s,)]|$))-?(\\d*\\.)?\\d+m?s(?=[\\s,)]|$)/"
          ],
          "animation": [
            "/(^|[\\s,(])(?!0m?s(?=[\\s,)]|$))-?(\\d*\\.)?\\d+m?s(?=[\\s,)]|$)/"
          ],
          "animation-duration": [
            "/(^|[\\s,(])(?!0m?s(?=[\\s,)]|$))-?(\\d*\\.)?\\d+m?s(?=[\\s,)]|$)/"
          ],
          "animation-delay": [
            "/(^|[\\s,(])(?!0m?s(?=[\\s,)]|$))-?(\\d*\\.)?\\d+m?s(?=[\\s,)]|$)/"
          ]
        }
      }
    }
  ]
}
